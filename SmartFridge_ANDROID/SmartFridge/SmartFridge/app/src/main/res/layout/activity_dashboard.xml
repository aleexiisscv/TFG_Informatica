<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:id="@+id/labelProductos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Productos en el frigorífico"
            android:textAllCaps="true"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Tabla de productos -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <TableLayout
                android:id="@+id/tableProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1" />
        </ScrollView>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- Botón de cerrar sesión -->

            <!-- Botón de estadísticas -->

            <!-- Botón para crear productos -->

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="121dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Cerrar sesión" />

            <Button
                android:id="@+id/statsButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="Estadísticas" />

            <Button
                android:id="@+id/createProductButton"
                android:layout_width="119dp"
                android:layout_height="wrap_content"
                android:text="Crear Producto" />
        </LinearLayout>

        <!-- Switch ON/OFF -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/labelRFIDStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RFID: OFF"
                android:textSize="16sp"
                android:gravity="center_vertical" />

            <Switch
                android:id="@+id/switchRFID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>