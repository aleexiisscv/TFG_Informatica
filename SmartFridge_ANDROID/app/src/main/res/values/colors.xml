    <!--
        ===== Colores de DOMINIO =====
        Deliberadamente FUERA del esquema M3 y por tanto inmunes al
        color dinamico: el Nutri-Score es un codigo de color normativo
        (Reglamento (UE) 1169/2011, escala Nutri-Score oficial). Si el
        fondo de pantalla del usuario tinera la "A" de morado, el
        indicador dejaria de ser legible como informacion nutricional.
        Semantica > estetica.
    -->
    <color name="nutri_a">#038141</color>
    <color name="nutri_b">#85BB2F</color>
    <color name="nutri_c">#FECB02</color>
    <color name="nutri_d">#EE8100</color>
    <color name="nutri_e">#E63E11</color>
    <color name="nutri_on_light">#FFFFFF</color>
    <color name="nutri_on_dark">#1A1A1A</color>
    <color name="nutri_unknown">#8A9294</color>

    <!-- Estado de sensor: verde/ambar/rojo son convenciones de alarma
         industrial; tampoco se delegan al color dinamico. -->
    <color name="state_ok">#2E7D32</color>
    <color name="state_ok_container">#C8E6C9</color>
    <color name="state_warn">#B26A00</color>
    <color name="state_warn_container">#FFE0B2</color>
    <color name="state_alert">#C62828</color>
    <color name="state_alert_container">#FFCDD2</color>
</resources>
