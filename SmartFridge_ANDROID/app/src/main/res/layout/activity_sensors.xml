<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:id="@+id/sensorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado Actual de los Sensores"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Descripción -->
    <TextView
        android:id="@+id/sensorDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Los valores mostrados reflejan el estado en tiempo real de los componentes del frigorífico. Los sensores miden agua, temperatura, humedad y si la puerta está abierta."
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/sensorTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contenedor para los sensores -->
    <LinearLayout
        android:id="@+id/sensorLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/sensorDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Agua -->
        <TextView
            android:id="@+id/waterSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor de Agua: 0.0"
            android:textSize="18sp"/>

        <!-- Temperatura -->
        <TextView
            android:id="@+id/tempSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Temperatura: 5ºC"
            android:textSize="18sp"/>

        <!-- Humedad -->
        <TextView
            android:id="@+id/humiditySensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Humedad: 45%"
            android:textSize="18sp"/>

        <!-- Puerta -->
        <TextView
            android:id="@+id/doorSensor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puerta Abierta: 1.0"
            android:textSize="18sp"/>
    </LinearLayout>

    <!-- Botón Volver -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/sensorLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
