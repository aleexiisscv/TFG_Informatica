<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja del usuario: alineada al final, color primario del tema
     (por tanto tambien sensible al color dinamico). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/bubbleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_bubble_out"
        android:drawablePadding="@dimen/space_s"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnPrimaryContainer"
        tools:text="Que caduca esta semana?" />
</FrameLayout>
