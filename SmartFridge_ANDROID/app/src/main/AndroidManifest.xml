<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        PERMISOS: principio de minimo privilegio.

        Se RETIRAN respecto a la version anterior:
          - READ_PHONE_STATE  : permiso PELIGROSO (dispara dialogo en
            tiempo de ejecucion) que ningun punto del codigo usaba.
            Su sola presencia obliga al usuario a conceder acceso a la
            identidad del dispositivo sin contrapartida, y es motivo de
            rechazo en la revision de Google Play.
          - WAKE_LOCK         : no se mantiene la CPU despierta en
            ningun punto.
          - POST_NOTIFICATIONS: no hay notificaciones implementadas. Se
            volvera a declarar el dia que las alertas de sensor se
            emitan tambien con la app cerrada.

        NO se declaran CAMERA ni RECORD_AUDIO a proposito: el escaneo
        delega en la app de camara del sistema (ActivityResultContracts.
        TakePicturePreview) y el dictado en el reconocedor del sistema
        (RecognizerIntent), asi que el sensor nunca se abre desde este
        proceso. Solo habra que declararlos si en el futuro se integra
        una vista previa en vivo con CameraX o SpeechRecognizer en
        proceso.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- La camara es un apoyo, no un requisito: la app debe seguir
         instalandose en dispositivos sin ella. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SmartFridgeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartFridge"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!--
            usesCleartextTraffic sigue en true porque el backend Spring
            Boot se sirve por HTTP plano en la red local del laboratorio.
            MEJORA RECOMENDADA para la memoria: sustituirlo por un
            res/xml/network_security_config.xml que permita texto claro
            SOLO para la IP del backend, dejando el resto de trafico
            obligado a TLS. Asi se acota la excepcion en lugar de abrir
            la app entera.
        -->

        <!-- Arranque -->
        <activity
            android:name=".LoadingActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartFridge.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autenticacion -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Contenedor de las tres secciones principales. Sustituye a
            DashboardActivity y SensorActivity, que dejan de existir como
            Activities y pasan a ser fragmentos del mismo NavHost.
            adjustResize es imprescindible para que la barra de escritura
            del asistente suba con el teclado.
        -->
        <activity
            android:name=".MainShellActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Flujos secundarios: sin barra de navegacion inferior -->
        <activity
            android:name=".CreateProductActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".StatsActivity"
            android:exported="false" />
        <activity
            android:name=".ScanProductActivity"
            android:exported="false" />
    </application>

</manifest>
