<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>com.smartfridge</groupId>
    <artifactId>smartfridge-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>smartfridge-backend</name>
    <description>
        Backend de la capa de Procesamiento del TFG SmartFridge.
        Sustituye a los Servlets Java + Apache Tomcat + MariaDB del sistema legacy,
        inaccesible tras la baja de la máquina virtual original.
    </description>

    <properties>
        <java.version>21</java.version>
        <org.eclipse.paho.version>1.2.5</org.eclipse.paho.version>
    </properties>

    <dependencies>

        <!-- ===================== CAPA WEB (API REST) =====================
             Sustituye a HttpServlet/@WebServlet. Expondrá los endpoints que
             hoy consumen la app Android y la interfaz web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ===================== PERSISTENCIA: SPRING DATA JPA =====================
             Sustituye a ConnectionDB (JDBC + SQL manual repetido en 2 módulos
             distintos del proyecto legacy: Server y Android). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver JDBC PostgreSQL: motor recomendado para el nuevo alojamiento
             en la nube (Railway / Render / Supabase, todos con tier gratuito). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===================== VALIDACIÓN =====================
             Bean Validation (@NotNull, @Email, etc.) sobre entidades/DTOs;
             el sistema legacy no validaba nada antes de tocar la BBDD. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===================== SEGURIDAD =====================
             Necesaria desde ya para el PasswordEncoder (BCrypt). El sistema
             legacy comparaba contraseñas en texto plano contra la BBDD
             (users.pass) — es el primer "quick win" de seguridad de esta fase.
             La configuración de JWT/OAuth2 para los endpoints se abordará en
             la fase de Controladores/Seguridad. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ===================== JWT (Fase 13) =====================
             Resource Server de Spring Security: aporta el filtro que valida
             el "Authorization: Bearer ..." y, vía spring-security-oauth2-jose
             (Nimbus), tanto el JwtDecoder como el JwtEncoder.

             Se elige esto en lugar de una librería suelta como jjwt porque
             la validación (firma, expiración, emisor) la hace un componente
             mantenido por el equipo de Spring e integrado en la cadena de
             filtros, en vez de un @ControllerAdvice o un filtro propio
             escrito a mano. Menos código nuestro en la ruta crítica de
             seguridad es exactamente lo que se quiere en la ruta crítica de
             seguridad. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ===================== MQTT =====================
             Cliente Paho: la misma librería que ya usaba el backend legacy
             (mqtt.MQTTBroker / MQTTSuscriber), envuelta ahora en un
             @Service de Spring en lugar de una clase estática singleton
             instanciada a mano desde un ServletContextListener. -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>${org.eclipse.paho.version}</version>
        </dependency>

        <!-- ===================== UTILIDADES ===================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===================== TESTS =====================
             El sistema legacy no tenía ni un solo test: la lógica estaba
             acoplada a java.sql.Connection y a servlets, imposibles de
             mockear sin un servidor real en marcha. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ===================== ENTORNO LOCAL (opcional) ===================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
